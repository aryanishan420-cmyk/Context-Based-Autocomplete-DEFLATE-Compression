# Build:  make            -> bin/autocomplete, bin/deflate, bin/run_tests
#         make test       -> unit tests
#         make interop    -> checks our gzip output against the system gzip/zlib
#         make data       -> downloads the Project Gutenberg corpus
#         make demo       -> end-to-end run over the real corpus

CXX      ?= g++
CXXFLAGS ?= -std=c++17 -O2 -Wall -Wextra -Wpedantic -Isrc
DEPFLAGS := -MMD -MP
LDFLAGS  ?=

BIN      := bin
BUILD    := build

DEFLATE_SRC := $(wildcard src/deflate/*.cpp)
AC_SRC      := $(wildcard src/autocomplete/*.cpp)
LIB_SRC     := $(DEFLATE_SRC) $(AC_SRC)
TEST_SRC    := $(wildcard tests/*.cpp)

LIB_OBJ  := $(patsubst %.cpp,$(BUILD)/%.o,$(LIB_SRC))
TEST_OBJ := $(patsubst %.cpp,$(BUILD)/%.o,$(TEST_SRC))

.PHONY: all test interop data demo bench clean format-check help

all: $(BIN)/autocomplete $(BIN)/deflate $(BIN)/run_tests

$(BIN)/autocomplete: $(BUILD)/src/apps/autocomplete_main.o $(LIB_OBJ)
	@mkdir -p $(BIN)
	$(CXX) $^ -o $@ $(LDFLAGS)

$(BIN)/deflate: $(BUILD)/src/apps/deflate_main.o $(LIB_OBJ)
	@mkdir -p $(BIN)
	$(CXX) $^ -o $@ $(LDFLAGS)

$(BIN)/run_tests: $(TEST_OBJ) $(LIB_OBJ)
	@mkdir -p $(BIN)
	$(CXX) $^ -o $@ $(LDFLAGS)

$(BUILD)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -Itests -c $< -o $@

# Header dependencies, generated by the compiler, so editing a header rebuilds
# everything that includes it.
-include $(shell find $(BUILD) -name '*.d' 2>/dev/null)

test: $(BIN)/run_tests
	./$(BIN)/run_tests

interop: $(BIN)/deflate
	./scripts/interop_test.sh

data:
	./scripts/fetch_data.sh

demo: all
	./scripts/demo.sh

bench: all
	./scripts/bench.sh

clean:
	rm -rf $(BUILD) $(BIN)

help:
	@sed -n '1,7p' Makefile
